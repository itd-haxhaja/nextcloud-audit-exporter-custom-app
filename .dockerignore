# Everything that is NOT part of the shipped Nextcloud app.
# Despite its name this file is not used by a container build any more. It is the single
# source of truth for the app's content: `make build` and tests/docker/seed.sh feed it to
# rsync (--exclude-from), so the release tarball and the test instance carry identical files.
.git/
.gitignore
.dockerignore
Makefile
composer.json
composer.lock
phpunit.xml
phpunit.integration.xml
*.cache
tests/
vendor/
dist/
node_modules/
STORE.md
