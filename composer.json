{
    "name": "itdesign/audit-export",
    "description": "AudIT Permission Exporter — Nextcloud app",
    "type": "nextcloud-app",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0",
        "nextcloud/ocp": "^27.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\AuditExport\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\AuditExport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test-integration": "phpunit --configuration phpunit.integration.xml"
    }
}
